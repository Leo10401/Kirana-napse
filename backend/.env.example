# ==========================================
# Kirana-Napse Backend Environment Variables
# ==========================================

# Application Environment (production / development)
APP_ENV=production
HOST=0.0.0.0
PORT=8000

# MongoDB Atlas Connection String
# Get this from MongoDB Atlas (Database -> Connect -> Drivers -> Python)
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=kirana_napse

# JWT Authentication Secret (Generate a strong random string)
JWT_SECRET=kirana-napse-super-secret-jwt-key-change-for-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=168

# Render Keep-Alive Configuration (Automated Heartbeat Ping)
# Render automatically sets RENDER_EXTERNAL_URL in production
KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_INTERVAL_SECONDS=210

# Firebase Cloud Messaging (Optional, for push notifications)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
